<%
  const posts = page.posts ? page.posts.toArray() : [];

  function coverFor(post) {
    if (post.cover) {
      const dir = post.path.replace(/index\.html$/, '');
      return config.root + dir + post.cover;
    }
    if (post.hero_image) return post.hero_image;
    if (theme.newsroom && theme.newsroom.default_cover) return theme.newsroom.default_cover;
    return '';
  }

  function badgeFor(post) {
    if (post.badge) return post.badge.toUpperCase();
    const cats = post.categories && (post.categories.toArray ? post.categories.toArray() : post.categories.data);
    if (cats && cats.length) return (cats[0].name || cats[0]).toUpperCase();
    return 'UPDATE';
  }
%>

<main class="newsroom-main">

  <!-- Everydayfeed Section -->
  <section class="everydayfeed">
    <div class="everydayfeed-grid">

      <% posts.forEach((post, index) => { 
          const cover = coverFor(post);
          const badge = badgeFor(post);

          // Determine card type
          let cardType = '';
          if (index === 0) cardType = 'card-hero';
          else if (index >= 1 && index <= 4) cardType = 'card-secondary';
          else cardType = 'card-standard';
      %>

      <!-- Card -->
      <article class="newsroom-card <%= cardType %>">
        <a href="<%- url_for(post.path) %>" class="newsroom-card__link">

          <div class="newsroom-card__media">
            <% if (cover) { %>
              <img src="<%- cover %>" alt="<%- post.title %>" loading="lazy">
            <% } else { %>
              <div class="newsroom-card__placeholder"></div>
            <% } %>
          </div>

          <div class="newsroom-card__body">
            <span class="newsroom-card__tag"><%= badge %></span>
            <h2 class="newsroom-card__title"><%= post.title %></h2>
            <time class="newsroom-card__date">
              <%= date(post.date, 'YYYY 年 MM 月 DD 日') %>
            </time>
          </div>

        </a>
      </article>

      <% }) %>

    </div>
  </section>

  <%- partial('partials/pagination') %>

</main>
