<main class="article-main">

  <!-- Header block (full width 980px) -->
  <section class="article-header-outer">
    <header class="article-header">
      <div class="article-meta-category"><%= page.categories.data[0].name %></div>
      <div class="article-meta-date">
        <%= date(page.date, 'YYYY 年 M 月 D 日') %>
      </div>
      <h1 class="article-title"><%= page.title %></h1>
      <!-- <span>
        浏览量：<span id="view-count">-</span>
      </span> -->

    </header>
  </section>

  <!-- Hero block (full width 980px) -->
  <% if (page.cover) { %>
    <section class="article-hero-outer">
      <figure class="article-hero">
        <img src="<%- config.root + page.path + page.cover %>" alt="<%= page.title %>">
      </figure>
    </section>
  <% } %>

  <!-- Content block (700px) -->
  <section class="newsroom-article">
    <div class="article-content">
      <%- page.content %>
    </div>
  </section>

</main>

<script>
  const slug = window.location.pathname;
  const API_BASE = "http://127.0.0.1:8000";

  const STORAGE_KEY = `viewed_once:${slug}`;

  window.addEventListener("load", function () {

    // 只在本次页面会话内 +1
    if (!sessionStorage.getItem(STORAGE_KEY)) {
      fetch(`${API_BASE}/api/views${slug}`, {
        method: "POST"
      }).finally(() => {
        sessionStorage.setItem(STORAGE_KEY, "1");
      });
    }

    // 始终获取当前浏览量
    fetch(`${API_BASE}/api/views${slug}`)
      .then(res => res.json())
      .then(data => {
        const viewEl = document.getElementById("view-count");
        if (viewEl) {
          viewEl.innerText = data.view_count;
        }
      });

  });
</script>

