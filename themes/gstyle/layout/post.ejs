<!-- Article Header -->
<header class="article-header">
  <h1 class="article-title"><%- page.title %></h1>
  <div class="article-meta">
    <time class="article-date" datetime="<%= page.date.toISOString() %>">
      <%= date(page.date, 'YYYY-MM-DD') %>
    </time>
  </div>
</header>

<!-- Article Content -->
<main class="typora-content">
  <%- page.content %>
</main>
