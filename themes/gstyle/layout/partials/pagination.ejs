<% if (page.total > 1) { %>
<nav class="pagination-ctrl">

    <!-- 上一页 -->
    <% if (page.prev) { %>
    <a class="pagination-btn pagination-btn-left" href="<%- url_for(page.prev_link) %>">
        <span class="arrow-left"></span>
    </a>
    <% } else { %>
    <span class="pagination-btn pagination-btn-left disabled">
        <span class="arrow-left"></span>
    </span>
    <% } %>

    <!-- 页码显示（当前页 / 总页数） -->
    <span class="pagination-text">
        <span class="pagination-current"><%= page.current %></span>
        页
        <%= page.total %>
    </span>

    <!-- 下一页 -->
    <% if (page.next) { %>
    <a class="pagination-btn pagination-btn-right" href="<%- url_for(page.next_link) %>">
        <span class="arrow-right"></span>
    </a>
    <% } else { %>
    <span class="pagination-btn pagination-btn-right disabled">
        <span class="arrow-right"></span>
    </span>
    <% } %>

</nav>
<% } %>
