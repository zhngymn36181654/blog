<header class="ac-ln-shell">
  <div class="ac-ln-wrapper">
    <div class="ac-ln-content">

      <!-- Left Title -->
      <span class="ac-ln-title">
        <div id="facehash-avatar-container"></div>
      </span>

      <!-- Main Menu Container -->
      <div class="ac-ln-menu">

        <!-- Desktop Horizontal Menu -->
        <ul class="ac-ln-menu-items ac-ln-menu-items-desktop">
          <li class="ac-ln-menu-item"><a class="ac-ln-menu-link" href="<%- url_for('/') %>">Home</a></li>
          <li class="ac-ln-menu-item"><a class="ac-ln-menu-link" href="<%- url_for('/archives') %>">Archive</a></li>
          <li class="ac-ln-menu-item"><a class="ac-ln-menu-link" href="<%- url_for('/about') %>">About</a></li>
          <li class="ac-ln-menu-item is-search"><a class="ac-ln-menu-link" href="<%- url_for('/search') %>">Search</a></li>
        </ul>

        <!-- Mobile Actions: Menu Toggle + Search Capsule + Tray -->
        <div class="ac-ln-actions">
          <!-- Mobile Menu Toggle + Chevron -->
          <div class="ac-ln-action ac-ln-action-menucta">
            <label class="ac-ln-menucta" id="ac-ln-menustate-trigger">
              <span class="ac-ln-menucta-chevron">
                <svg viewBox="0 0 16 9" class="ac-ln-chevron-svg">
                  <polyline id="ac-chevron-poly"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    vector-effect="non-scaling-stroke"
                    fill="none"
                    points="15.265 .835 8 8.167 .735 .835">

                    <!-- 展开动画 (V → 平线 → ^) -->
                    <animate id="ac-chevron-expand"
                      attributeName="points"
                      begin="indefinite"
                      dur="320ms"
                      fill="freeze"
                      keyTimes="0; 0.5; 1"
                      calcMode="spline"
                      keySplines="0.12,0,0.38,0; 0.2,1,0.68,1"
                      values="
                        15.265 .835 8 8.167 .735 .835;
                        15.25 4.5 8 4.5 .75 4.5;
                        15.265 8.165 8 .835 .735 8.165
                      " />

                    <!-- 收起动画 (^ → 平线 → V) -->
                    <animate id="ac-chevron-collapse"
                      attributeName="points"
                      begin="indefinite"
                      dur="320ms"
                      fill="freeze"
                      keyTimes="0; 0.5; 1"
                      calcMode="spline"
                      keySplines="0.2,0,0.68,0; 0.2,1,0.68,1"
                      values="
                        15.265 8.165 8 .835 .735 8.165;
                        15.25 4.5 8 4.5 .75 4.5;
                        15.265 .835 8 8.167 .735 .835
                      " />

                  </polyline>
                </svg>
              </span>
            </label>
          </div>


          <!-- Mobile Search Capsule -->
          <div class="ac-ln-action ac-ln-action-search">
            <a class="ac-ln-search-capsule" href="<%- url_for('/search') %>">
              <span class="ac-ln-search-icon">
                <svg viewBox="0 0 15 15" width="15" height="15" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1.5" fill="none" />
                  <line x1="10.5" y1="10.5" x2="14" y2="14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              </span>
              <span class="ac-ln-search-text">搜索</span>
            </a>
          </div>



        </div>
        <!-- Mobile Dropdown Tray -->
        <div class="ac-ln-menu-tray">
          <ul class="ac-ln-menu-items">
            <li class="ac-ln-menu-item">
              <a class="ac-ln-menu-link local-nav-link" href="<%- url_for('/') %>">Home</a>
            </li>
            <li class="ac-ln-menu-item">
              <a class="ac-ln-menu-link local-nav-link" href="<%- url_for('/archives') %>">Archive</a>
            </li>
            <li class="ac-ln-menu-item">
              <a class="ac-ln-menu-link local-nav-link" href="<%- url_for('/about') %>">About</a>
            </li>
          </ul>
        </div>
      </div>
      <div class="ac-ln-overlay"></div>

    </div>
  </div>
</header>