<!DOCTYPE html>
    <%- partial('partials/head') %>
    <% 
    let bodyClass = 'page-other';
    if (is_home()) bodyClass = 'page-home';
    else if (is_post()) bodyClass = 'page-post';
    else if (is_archive()) bodyClass = 'page-archive';
    else if (page.layout === 'about') bodyClass = 'page-about';
    %>

    <body class="<%= bodyClass %>">
        <header>
            <!-- cover image or sth. -->
        </header>
        <div id="main">
            <%- partial('partials/nav') %>
            <div class="container content">
                <div>
                    <%- body %>
                </div>
            </div>
        </div>
        <%- partial('partials/footer') %>
    </body>
</html>

