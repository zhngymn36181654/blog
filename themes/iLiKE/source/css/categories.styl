.category-group {
  margin-bottom: 2rem;
}

.category-name {
  border-bottom: 2px solid #3498db;
  padding-bottom: 0.5rem;
}

.category-name a {
  color: #333;
  text-decoration: none;
}

.category-count {
  color: #666;
  font-size: 0.8em;
}

.category-posts {
  list-style: none;
  padding-left: 1rem;
}

.post-item {
  margin: 0.5rem 0;
  padding: 0.3rem 0;
}

.post-date {
  color: #666;
  font-size: 0.9em;
  margin-right: 1rem;
}

.post-title {
  color: #3498db;
  text-decoration: none;
}

.post-title:hover {
  text-decoration: underline;
}