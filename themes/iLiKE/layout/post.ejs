<h1 class="post-title"><%=page.title%></h1>

<!-- 文章元数据：日期、分类、标签 -->
<div class="post-meta">
  <span class="post-date"><%= date(page.date) %></span>
  
  <% if (page.categories && page.categories.length > 0) { %>
    <span class="post-categories">
      分类: 
      <% page.categories.each(function(category) { %>
        <a href="<%= url_for(category.path) %>"><%= category.name %></a>
      <% }) %>
    </span>
  <% } %>
  
  <% if (page.tags && page.tags.length > 0) { %>
    <span class="post-tags">
      标签: 
      <% page.tags.each(function(tag) { %>
        <a href="<%= url_for(tag.path) %>"><%= tag.name %></a>
      <% }) %>
    </span>
  <% } %>
</div>

<article class="post markdown-style">
  <%-page.content%>
</article>

<!-- Waline 评论区域 -->
<div class="waline-comment-container" style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid #eee;">
    <h3 style="margin-bottom: 1.5rem;">💬 评论</h3>
    <div id="waline"></div>
</div>

<%-partial('partials/paginator') %>

<!-- Waline 样式和脚本 -->
<link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
<script type="module">
    import { init } from 'https://unpkg.com/@waline/client@v3/dist/waline.js';
    
    init({
        el: '#waline',
        serverURL: 'https://comment.lostround.xyz', 
        path: '<%= page.path %>',
        comment: true,
        pageview: true,
        dark: 'auto'
    });
</script>