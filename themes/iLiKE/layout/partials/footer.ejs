<div class="container">
    <%- partial('partials/social', {}) %>
        <div class="copyright">
            <span>
                <% var author="iLiKE Theme" ; if (config.author) { author=config.author; } %>
                    <% if (theme.since) { var start=theme.since; var end=date(Date.now(),'YYYY'); var cpTime=end; if
                        (start < end) { cpTime=start + " - " + end; } %>
                        © <%= author %>
                            <%= cpTime %>
                                <% } else { var end=date(Date.now(),'YYYY'); %>
                                    © <%= author %>
                                        <%= end %>
                                            <% } %>
            </span>
        </div>

        <!-- 不蒜子访客统计 -->
        <div class="busuanzi-stats">
            <span id="busuanzi_container_site_pv">
                📊 总访问量: <span id="busuanzi_value_site_pv"></span>
            </span>
            &nbsp;•&nbsp;
            <span id="busuanzi_container_site_uv">
                👥 访客数: <span id="busuanzi_value_site_uv"></span>
            </span>
        </div>

        <div class="power">
            <span>
                Powered by <a href="https://hexo.io">Hexo</a> & <a href="https://github.com/CaiChenghan/iLiKE">iLiKE
                    Theme</a>
            </span>
        </div>

        <script src="https://cdn.bootcss.com/jquery/3.3.1/jquery.js"></script>
        <!-- 不蒜子统计脚本 -->
        <script async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
        <%- partial('partials/counter') %>
</div>